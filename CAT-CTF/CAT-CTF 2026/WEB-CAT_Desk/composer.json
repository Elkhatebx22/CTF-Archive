{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "catdesk/app",
    "type": "project",
    "description": "CatDesk challenge application.",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "preferred-install": "dist",
        "sort-packages": true
    }
}
